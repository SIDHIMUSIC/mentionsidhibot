{
  "name": "MentionMayaBot",
  "description": "Telegram mention-all bot with admin controls, Hindi/English replies, and Heroku support.",
  "repository": "https://github.com/SIDHIMUSIC/mentionmayabot",
  "keywords": ["telegram", "bot", "mention", "tagall", "heroku"],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH from https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your numeric Telegram user ID (optional, for owner commands)",
      "required": false,
      "value": "0"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
